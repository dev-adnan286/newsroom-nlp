# Newsroom NLP configuration (all values optional; sensible defaults apply)
# Every variable is prefixed with NEWSROOM_

# Directory where trained models, indexes and reports are stored
NEWSROOM_ARTIFACTS_DIR=artifacts

# Embedding provider: "tfidf_svd" (offline default) or "sentence_transformers" (requires the `transformers` extra)
NEWSROOM_EMBEDDING_PROVIDER=tfidf_svd
NEWSROOM_EMBEDDING_DIM=256
NEWSROOM_SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# API settings
NEWSROOM_API_HOST=0.0.0.0
NEWSROOM_API_PORT=8000
# Leave empty to disable API-key authentication (the default)
NEWSROOM_API_KEY=
NEWSROOM_API_KEY_HEADER=X-API-Key

# Logging level: DEBUG, INFO, WARNING, ERROR
NEWSROOM_LOG_LEVEL=INFO

# Random seed used by corpus generation and model training
NEWSROOM_RANDOM_SEED=42
